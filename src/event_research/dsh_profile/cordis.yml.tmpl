# dsh 组合：事件层二档调研员（SDK 独立完整列表，非 patch）。
# 在 SDK bundled 默认组合（jsonrpc server + agent spine + llm-deepseek +
# session 持久化 + bash + fs）之上：开 web 搜索/抓取（web_fetch 默认关，这里
# 显式开并挂 http provider）、挂 Python hooks 桥（经费卡闸 + 白名单闸 + 打标器）。
# session 日志写纯文本 JSONL（compression none + packChunks false）供对账器逐行读。
# 模型不在此钉死：由 SDK 每次会话传入（runner 锁 deepseek-v4-flash）。

- id: sdk-jsonrpc-server
  name: '@deepseek-ai/dsh-sdk-jsonrpc-server'

- id: agent-core
  name: '@deepseek-ai/dsh-agent-spine-demo'
  config:
    workspaceContext:
      maxBytes: 65536
    # 人设由 runner 经环境变量注入（src/event_research/persona.md + 本次议程）。
    persona: !!js process.env.DSH_SYSTEM_PROMPT ?? ''

- id: llm-deepseek
  name: '@deepseek-ai/dsh-llm-deepseek'

- id: sessions
  name: '@deepseek-ai/dsh-session-persistence-jsonl'
  config:
    root: !!js process.env.DSH_SESSION_ROOT ?? './.sessions'
    compression: 'none'
    packChunks: false

- id: session-checkpoints
  name: '@deepseek-ai/dsh-session-checkpoint-policy'

- id: subprocess
  name: '@deepseek-ai/dsh-subprocess-local'

- id: bash
  name: '@deepseek-ai/dsh-bash-local'
  config:
    cwd: !!js process.env.DSH_CWD ?? process.cwd()

- id: fs-local
  name: '@deepseek-ai/dsh-fs-local'
  config:
    cwd: !!js process.env.DSH_CWD ?? process.cwd()

- id: web
  name: '@deepseek-ai/dsh-web'
  config:
    searchProvider: deepseek-official
    fetchProvider: http

- id: web-search-deepseek
  name: '@deepseek-ai/dsh-web-search-deepseek'
  config:
    apiKeyEnv: DEEPSEEK_API_KEY

- id: web-fetch-http
  name: '@deepseek-ai/dsh-web-fetch-http'

- id: tool-web
  name: '@deepseek-ai/dsh-tool-web'
  config:
    fetch: true
    searchTimeoutMs: 60000

# Python hooks 桥：经费卡闸（pre-step 硬停）、白名单闸（web_fetch 执行前）、
# 来源分级打标器（web_fetch 执行后）。hooks.json 由 runner 按 run 渲染（绝对路径）。
- id: hooks-cc
  name: '@deepseek-ai/dsh-hooks-claude-code'
  config:
    configPath: {{HOOKS_JSON_PATH}}
