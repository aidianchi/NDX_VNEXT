# NDX_VNEXT .gitignore
#
# Rule of thumb:
# - Keep source code, tests, docs, prompts, example configs, and plans.
# - Ignore secrets, virtual environments, caches, logs, and generated outputs.

# --- Secrets and local configuration ---
.env
.env.*
!.env.example
*.pem
*.key
*.secret
secrets/

# Local config files that may contain private keys or machine-specific paths.
config/*.local.json
config/*local*.json
launcher_prefs.json
CLAUDE.local.md

# Keep safe example configuration.
!config/*.example.json

# --- Python runtime artifacts ---
__pycache__/
*.py[cod]
*$py.class
.Python
*.so

# --- Virtual environments ---
.venv/
venv/
ENV/
env/

# --- Test and tool caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- JavaScript dependencies for local report prototypes ---
node_modules/

# --- Data caches and generated market artifacts ---
data_cache/
output/

# --- Logs and temporary files ---
*.log
ai_response_debug_*.txt
*.tmp
*.temp
tmp/
temp/

# --- Editor and OS files ---
.vscode/
.idea/
.obsidian/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# --- Local worktrees ---
.worktrees/

# Codex CLI 本机配置：2026-07-28 用户裁定不再追踪（每台机器不同，不属于项目资产）
.codex/config.toml

# WorkBuddy 工作区记忆与工具数据：2026-08-06 用户裁定不纳入版本控制
.workbuddy/

# ZCode 工具本机数据（plans 等）：每台机器不同，不属于项目资产
.zcode/

# 第三方版权原件（券商研报扫描件、他人信件 PDF）：本仓库为公开仓库，不入库。
# 语料用途由同目录下的提取稿（.md/.txt）承担，提取稿正常入库。
research_fundamental/L2_language/corpus/raw/*.pdf
investigation_reports/20260902_研报语言第一性/exemplars/*.pdf
